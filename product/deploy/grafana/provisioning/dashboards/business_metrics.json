    {
      "id": 33,
      "type": "stat",
      "title": "AML Alert Decisions",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "mfp-prometheus" },
