      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "mfp-prometheus" }, "expr": "increase(http_server_requests_seconds_count{instance=\"platform:8080\", uri=\"/api/v1/withdrawals\", method=\"POST\"}[$__range])", "legendFormat": "withdrawal requests" }]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Internal Transfers",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "mfp-prometheus" },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "mfp-prometheus" }, "expr": "increase(http_server_requests_seconds_count{instance=\"platform:8080\", uri=\"/api/v1/transfers\", method=\"POST\"}[$__range])", "legendFormat": "transfers" }]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Cards Issued",
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "mfp-prometheus" },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "mfp-prometheus" }, "expr": "increase(http_server_requests_seconds_count{instance=\"platform:8080\", uri=\"/api/v1/cards\", method=\"POST\"}[$__range])", "legendFormat": "cards issued" }]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Wallet Operation Rate (req/min)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "mfp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "mfp-prometheus" }, "expr": "rate(http_server_requests_seconds_count{instance=\"platform:8080\", uri=\"/api/v1/deposits\", method=\"POST\"}[5m]) * 60", "legendFormat": "deposits" },
        { "datasource": { "type": "prometheus", "uid": "mfp-prometheus" }, "expr": "rate(http_server_requests_seconds_count{instance=\"platform:8080\", uri=\"/api/v1/withdrawals\", method=\"POST\"}[5m]) * 60", "legendFormat": "withdrawals" },
        { "datasource": { "type": "prometheus", "uid": "mfp-prometheus" }, "expr": "rate(http_server_requests_seconds_count{instance=\"platform:8080\", uri=\"/api/v1/transfers\", method=\"POST\"}[5m]) * 60", "legendFormat": "transfers" }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Compliance & AML",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
