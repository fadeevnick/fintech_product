      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "mfp-prometheus" }, "expr": "increase(http_server_requests_seconds_count{instance=\"platform:8080\", uri=\"/api/v1/backoffice/aml-alerts/{id}/decision\", method=\"POST\"}[$__range])", "legendFormat": "aml decisions" }]
    },
    {
      "id": 34,
      "type": "stat",
      "title": "Chargebacks Initiated",
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "mfp-prometheus" },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "mfp-prometheus" }, "expr": "increase(http_server_requests_seconds_count{instance=\"platform:8080\", uri=\"/api/v1/card-payments/{paymentIntentId}/disputes\", method=\"POST\"}[$__range])", "legendFormat": "chargebacks" }]
