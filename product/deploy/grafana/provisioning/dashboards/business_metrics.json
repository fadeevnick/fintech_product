      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "mfp-prometheus" }, "expr": "increase(http_server_requests_seconds_count{instance=\"platform:8080\", uri=\"/api/v1/kyc/start\", method=\"POST\"}[$__range])", "legendFormat": "kyc starts" }]
