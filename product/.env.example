COMPOSE_PROJECT_NAME=mini-fintech-platform

POSTGRES_PASSWORD=local_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

PLATFORM_DB_URL=jdbc:postgresql://platform-db:5432/platform
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=platform

ACQUIRER_DB_URL=jdbc:postgresql://acquirer-db:5432/acquirer
ACQUIRER_DB_USER=acquirer
ACQUIRER_DB_PASSWORD=acquirer

NETWORK_DB_URL=jdbc:postgresql://network-db:5432/network
NETWORK_DB_USER=network
NETWORK_DB_PASSWORD=network

ISSUER_DB_URL=jdbc:postgresql://issuer-db:5432/issuer
ISSUER_DB_USER=issuer
ISSUER_DB_PASSWORD=issuer

VAULT_DB_URL=jdbc:postgresql://vault-db:5432/vault
VAULT_DB_USER=vault
VAULT_DB_PASSWORD=vault

# Stripe Connect — Phase 04 Slice 02 implements only the webhook receiver.
# Onboarding-start (Account.create / AccountLink.create) is blocked until real
# Stripe Connect sandbox credentials are provided; do not introduce a fake adapter.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# STRIPE_WEBHOOK_SIGNING_SECRET should match the value Stripe uses for the same
# webhook endpoint. The default below is a local-test value used by the retained
# Phase 04 webhook runtime scripts when no real Stripe sandbox is configured.
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_local_test_secret
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_SIGNING_SECRET_ENCRYPTION_KEY=local-webhook-signing-secret-key-change-me
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_DELAYS_SECONDS=1,2
SERVICE_AUTH_SECRET=local-service-secret
VAULT_PAN_ENCRYPTION_KEY=local-vault-pan-key-change-me
VAULT_TEST_BIN=400000
